@model Donation
@{
    ViewData["Title"] = "Thank You";
}

<section class="py-5">
    <div class="container text-center" style="max-width: 620px;">
        <div class="gg-avatar mx-auto mb-4" style="width: 72px; height: 72px; font-size: 2rem; background-color: rgba(46,139,87,0.12); color: var(--gg-success);">
            <i class="bi bi-check-lg"></i>
        </div>
        <h1>Thank you for your generosity!</h1>
        <p class="text-muted lead">Your donation has been received and a Section 18A tax certificate has been issued.</p>

        <div class="card p-4 text-start mt-4">
            <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                <span class="text-muted">Reference number</span>
                <span class="fw-bold">@Model.ReferenceNumber</span>
            </div>
            <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                <span class="text-muted">Amount</span>
                <span class="fw-bold">@Model.Currency @(Model.Amount.ToString("N2"))</span>
            </div>
            <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                <span class="text-muted">Designated to</span>
                <span class="fw-bold">@(Model.Project?.Title ?? "General Emergency Fund")</span>
            </div>
            <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                <span class="text-muted">Type</span>
                <span class="fw-bold">@Model.Type</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">Date</span>
                <span class="fw-bold">@Model.DonationDate.ToString("dd MMMM yyyy")</span>
            </div>
        </div>

        @if (Model.TaxCertificate is not null)
        {
            <a class="btn btn-primary btn-lg mt-4" asp-controller="Donor" asp-action="DownloadCertificate" asp-route-certificateNumber="@Model.TaxCertificate.CertificateNumber">
                <i class="bi bi-download me-2"></i>Download tax certificate
            </a>
        }

        <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
            <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Back to home</a>
            <a class="btn btn-outline-primary" asp-controller="Project" asp-action="Index">See other projects</a>
        </div>
    </div>
</section>


