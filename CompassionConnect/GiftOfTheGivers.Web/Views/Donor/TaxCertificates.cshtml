@model IReadOnlyList<TaxCertificate>
@{
    ViewData["Title"] = "Tax Certificates";
}
<section class="py-5">
    <div class="container-fluid px-4">
        <div class="row">
            <div class="col-lg-3"><partial name="_DonorSidebar" /></div>
            <div class="col-lg-9">
                <h2 class="mb-4">Section 18A Tax Certificates</h2>
                <div class="card p-4">
                    <div class="table-responsive">
                        <table class="table table-gg align-middle">
                            <thead><tr><th>Certificate #</th><th>Donation</th><th>Amount</th><th>Issued</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var certificate in Model)
                                {
                                    <tr>
                                        <td class="small">@certificate.CertificateNumber</td>
                                        <td class="small">@certificate.Donation?.ReferenceNumber</td>
                                        <td class="small fw-semibold">R@(certificate.Amount.ToString("N2"))</td>
                                        <td class="small">@certificate.DateIssued.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <a class="btn btn-sm btn-outline-primary" asp-controller="Donor" asp-action="DownloadCertificate" asp-route-certificateNumber="@certificate.CertificateNumber">
                                                <i class="bi bi-download me-1"></i>Download PDF
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!Model.Any())
                    {
                        <div class="alert alert-info mb-0">No tax certificates have been issued yet.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>


