@model ErrorViewModel?
@{
    ViewData["Title"] = "Error";
}

<section class="py-5">
    <div class="container text-center py-5">
        <i class="bi bi-exclamation-octagon text-danger" style="font-size: 3rem;"></i>
        <h1 class="mt-3">Something went wrong</h1>
        <p class="text-muted">An unexpected error occurred while processing your request.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index">Return home</a>
    </div>
</section>


