@{
    ViewData["Title"] = "Contact Us";
}

<section class="gg-hero py-5">
    <div class="container py-3 text-center">
        <span class="gg-eyebrow text-white-50">Get in touch</span>
        <h1 class="mt-2">We're here to help</h1>
        <p class="lead mx-auto" style="max-width: 36rem; color: rgba(255,255,255,0.85);">
            Whether you have a question about donating, volunteering, or want to report an emergency, our team is ready to assist.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5">
                <h4 class="mb-4">Contact information</h4>
                <div class="d-flex gap-3 mb-4">
                    <div class="gg-avatar flex-shrink-0"><i class="bi bi-telephone-fill"></i></div>
                    <div>
                        <h6 class="mb-1">Emergency Hotline</h6>
                        <p class="text-muted mb-0">0800 786 911 &mdash; available 24 hours a day</p>
                    </div>
                </div>
                <div class="d-flex gap-3 mb-4">
                    <div class="gg-avatar flex-shrink-0"><i class="bi bi-envelope-fill"></i></div>
                    <div>
                        <h6 class="mb-1">Email</h6>
                        <p class="text-muted mb-0">info@giftofthegivers.org</p>
                    </div>
                </div>
                <div class="d-flex gap-3 mb-4">
                    <div class="gg-avatar flex-shrink-0"><i class="bi bi-geo-alt-fill"></i></div>
                    <div>
                        <h6 class="mb-1">Head Office</h6>
                        <p class="text-muted mb-0">3 Barnfield Road, Overport, Durban, KwaZulu-Natal, South Africa</p>
                    </div>
                </div>
                <div class="d-flex gap-3">
                    <div class="gg-avatar flex-shrink-0"><i class="bi bi-clock-fill"></i></div>
                    <div>
                        <h6 class="mb-1">Office Hours</h6>
                        <p class="text-muted mb-0">Monday &ndash; Friday, 08:00 &ndash; 17:00 SAST</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="card p-4">
                    <h4 class="mb-3">Send us a message</h4>
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Full name</label>
                                <input type="text" class="form-control" placeholder="Your name" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email address</label>
                                <input type="email" class="form-control" placeholder="you@example.com" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Subject</label>
                                <select class="form-select">
                                    <option>General enquiry</option>
                                    <option>Donation question</option>
                                    <option>Volunteer application</option>
                                    <option>Media &amp; partnerships</option>
                                    <option>Report an emergency</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Message</label>
                                <textarea class="form-control" rows="5" placeholder="How can we help?" required></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-lg">Send message <i class="bi bi-send ms-1"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>


