  @model IReadOnlyList<NewsArticle>
@{
    ViewData["Title"] = "News & Updates";
}

<section class="gg-hero py-5">
    <div class="container py-3 text-center">
        <span class="gg-eyebrow text-white-50">From the field</span>
        <h1 class="mt-2">News &amp; Updates</h1>
        <p class="lead mx-auto" style="max-width: 36rem; color: rgba(255,255,255,0.85);">
            Stories, impact reports and field updates from our disaster response teams across South Africa.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <form class="d-flex flex-wrap gap-2 mb-4" method="get">
            <button type="submit" name="category" value="" class="btn btn-sm @(string.IsNullOrEmpty(Context.Request.Query["category"]) ? "btn-primary" : "btn-outline-primary")">All</button>
            @foreach (var category in Enum.GetValues<NewsCategory>())
            {
                <button type="submit" name="category" value="@category" class="btn btn-sm @(Context.Request.Query["category"] == category.ToString() ? "btn-primary" : "btn-outline-primary")">@category.ToDisplayName()</button>
            }
        </form>

        <div class="row g-4">
            @foreach (var article in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-hover h-100">
                        <img src="@article.ImageUrl" class="card-img-top object-fit-cover" style="height: 190px;" alt="@article.ImageAlt" onerror="this.src='/images/news/default-news.jpg'" />
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge badge-soft-primary">@article.Category.ToDisplayName()</span>
                                <span class="small text-muted">@article.PublishedDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <h5 class="card-title">@article.Title</h5>
                            <p class="card-text text-muted small flex-grow-1">@article.Excerpt</p>
                            <a asp-controller="News" asp-action="Details" asp-route-slug="@article.Slug" class="btn btn-outline-primary mt-2">Read more</a>
                        </div>
                    </div>
                </div>
            }
            @if (!Model.Any())
            {
                <div class="col-12"><div class="alert alert-info">No articles in this category yet.</div></div>
            }
        </div>
    </div>
</section>


