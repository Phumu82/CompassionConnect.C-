@using Microsoft.AspNetCore.Identity
@using GiftOfTheGivers.Web.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is not null ? $"{ViewData["Title"]} | Gift of the Givers Foundation" : "Gift of the Givers Foundation | Disaster Relief Platform")</title>
    <meta name="description" content="Support South African disaster relief through donations, volunteering and community partnerships with the Gift of the Givers Foundation." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.png" type="image/png" />
</head>
<body>
    <header class="gg-header">
        <div class="gg-topbar d-none d-lg-block">
            <div class="container d-flex justify-content-between align-items-center py-1">
                <p class="mb-0"><i class="bi bi-telephone-fill me-1"></i> 24-hour emergency hotline: <strong>0800 786 911</strong></p>
                <p class="mb-0">Section 18A tax certificates issued instantly on every donation.</p>
            </div>
        </div>

        <nav class="navbar navbar-expand-xl py-2">
            <div class="container">
                <a class="gg-logo navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/favicon.png"
                         alt="Gift of the Givers Foundation"
                         class="gg-logo-image" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#ggMobileNav" aria-controls="ggMobileNav" aria-label="Open menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse d-none d-xl-flex">
                    <ul class="navbar-nav gg-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Project" asp-action="Index">Projects</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Donation" asp-action="Index">Donate</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Volunteer" asp-action="Index">Volunteer</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="News" asp-action="Index">News</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var isEmployee = User.IsInRole("Employee");
                        <div class="dropdown d-none d-lg-block">
                            <button class="btn btn-light gg-avatar border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @(User.Identity!.Name!.Substring(0,2).ToUpper())
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><h6 class="dropdown-header">@(isEmployee ? "Employee" : "Donor") account</h6></li>
                                <li><a class="dropdown-item" asp-controller="@(isEmployee ? "Employee" : "Donor")" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Settings">Settings</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-none d-lg-flex align-items-center gap-1">
                            <a class="btn btn-sm btn-light" asp-controller="Account" asp-action="LoginDonor"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus me-1"></i>Register</a>
                        </div>
                    }
                    <a class="btn btn-sm btn-emergency d-none d-sm-inline-flex" asp-controller="Donation" asp-action="Index">Emergency Donate</a>
                </div>
            </div>
        </nav>
    </header>

    <div class="offcanvas-header border-bottom">
        <a class="gg-logo" asp-controller="Home" asp-action="Index">
            <img src="~/favicon.png"
                 alt="Gift of the Givers Foundation"
                 class="gg-logo-image" />
        </a>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
        <div class="offcanvas-body d-flex flex-column gap-1">
            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
            <a class="nav-link" asp-controller="Project" asp-action="Index">Projects</a>
            <a class="nav-link" asp-controller="Donation" asp-action="Index">Donate</a>
            <a class="nav-link" asp-controller="Volunteer" asp-action="Index">Volunteer</a>
            <a class="nav-link" asp-controller="News" asp-action="Index">News</a>
            <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
            <hr />
            <a class="btn btn-outline-primary w-100 mb-2" asp-controller="Account" asp-action="LoginEmployee">Employee Login</a>
            <a class="btn btn-outline-primary w-100 mb-2" asp-controller="Account" asp-action="LoginDonor">Donor Login</a>
            <a class="btn btn-emergency w-100" asp-controller="Donation" asp-action="Index">Emergency Donate</a>
        </div>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="gg-footer">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4">
                    <span class="gg-logo text-white"><span class="gg-logo-mark">GG</span> Gift of the Givers</span>
                    <p class="mt-3 small" style="max-width: 22rem;">
                        A South African disaster relief organisation delivering emergency aid, healthcare and
                        recovery support where it is needed most &mdash; since 1992.
                    </p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#" class="social-icon" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon" aria-label="X"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="social-icon" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-icon" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Organisation</h6>
                    <ul class="list-unstyled small mt-2">
                        <li class="mb-2"><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li class="mb-2"><a asp-controller="Project" asp-action="Index">Relief Projects</a></li>
                        <li class="mb-2"><a asp-controller="News" asp-action="Index">News &amp; Updates</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Get Involved</h6>
                    <ul class="list-unstyled small mt-2">
                        <li class="mb-2"><a asp-controller="Donation" asp-action="Index">Donate</a></li>
                        <li class="mb-2"><a asp-controller="Volunteer" asp-action="Index">Volunteer</a></li>
                        <li class="mb-2"><a asp-controller="Account" asp-action="Register">Register</a></li>
                        <li class="mb-2"><a asp-controller="Account" asp-action="LoginDonor">Donor Login</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Staff</h6>
                    <ul class="list-unstyled small mt-2">
                        <li class="mb-2"><a asp-controller="Account" asp-action="LoginEmployee">Employee Login</a></li>
                        <li class="mb-2"><a asp-controller="Employee" asp-action="Dashboard">Employee Dashboard</a></li>
                        <li class="mb-2"><a asp-controller="Donor" asp-action="History">Donation History</a></li>
                        <li class="mb-2"><a asp-controller="Account" asp-action="Settings">Settings</a></li>
                    </ul>
                </div>
                <div class="col-lg-2">
                    <h6>Newsletter</h6>
                    <form class="mt-2">
                        <label for="newsletter-email" class="small mb-1 d-block">Monthly impact report</label>
                        <input id="newsletter-email" type="email" class="form-control form-control-sm mb-2" placeholder="you@example.com" />
                        <button type="submit" class="btn btn-emergency btn-sm w-100">Subscribe</button>
                    </form>
                </div>
            </div>
            <hr class="border-secondary mt-4" />
            <div class="d-flex flex-column flex-sm-row justify-content-between small pt-2">
                <span>&copy; @DateTime.Now.Year Gift of the Givers Foundation. All rights reserved.</span>
                <span>PBO 930033254 &nbsp;|&nbsp; NPO 015-644</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


