@{
    var current = ViewContext.RouteData.Values["action"]?.ToString();
}
<div class="gg-sidebar-nav rounded-4 p-3 mb-4 mb-lg-0">
    <div class="text-white fw-bold px-2 mb-3"><i class="bi bi-speedometer2 me-2"></i>Staff Portal</div>
    <nav class="nav flex-column gap-1">
        <a class="nav-link @(current == "Dashboard" ? "active" : "")" asp-controller="Employee" asp-action="Dashboard"><i class="bi bi-grid-1x2 me-2"></i>Overview</a>
        <a class="nav-link @(current == "Projects" ? "active" : "")" asp-controller="Employee" asp-action="Projects"><i class="bi bi-kanban me-2"></i>Projects</a>
        <a class="nav-link @(current == "Donations" ? "active" : "")" asp-controller="Employee" asp-action="Donations"><i class="bi bi-cash-coin me-2"></i>Donations</a>
        <a class="nav-link @(current == "Volunteers" ? "active" : "")" asp-controller="Employee" asp-action="Volunteers"><i class="bi bi-people me-2"></i>Volunteers</a>
        <a class="nav-link @(current == "News" ? "active" : "")" asp-controller="Employee" asp-action="News"><i class="bi bi-newspaper me-2"></i>News</a>
        <a class="nav-link @(current == "Reports" ? "active" : "")" asp-controller="Employee" asp-action="Reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
    </nav>
</div>


