@model IReadOnlyList<ReliefProject>
@{
    ViewData["Title"] = "Projects";
}
<section class="py-5">
    <div class="container-fluid px-4">
        <div class="row">
            <div class="col-lg-3"><partial name="_EmployeeSidebar" /></div>
            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">Manage Projects</h2>
                    <a asp-controller="Project" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New project</a>
                </div>
                <div class="card p-4">
                    <div class="table-responsive">
                        <table class="table table-gg align-middle">
                            <thead><tr><th>Title</th><th>Province</th><th>Category</th><th>Status</th><th>Raised / Goal</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var project in Model)
                                {
                                    <tr>
                                        <td class="small">@project.Title</td>
                                        <td class="small">@project.Province</td>
                                        <td class="small">@project.Category</td>
                                        <td><span class="status-pill @project.Status.ToString().ToLower()">@project.Status</span></td>
                                        <td class="small">R@(project.RaisedAmount.ToString("N0")) / R@(project.GoalAmount.ToString("N0"))</td>
                                        <td class="d-flex gap-1">
                                            <a asp-controller="Project" asp-action="Edit" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-primary">Edit</a>
                                            <form asp-controller="Project" asp-action="Delete" asp-route-id="@project.ProjectId" method="post" onsubmit="return confirm('Delete this project?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


