@model IReadOnlyList<NewsArticle>
@{
    ViewData["Title"] = "Manage News";
}
<section class="py-5">
    <div class="container-fluid px-4">
        <div class="row">
            <div class="col-lg-3"><partial name="_EmployeeSidebar" /></div>
            <div class="col-lg-9">
                <h2 class="mb-4">News Articles</h2>
                <div class="card p-4">
                    <div class="table-responsive">
                        <table class="table table-gg align-middle">
                            <thead><tr><th>Title</th><th>Category</th><th>Author</th><th>Published</th><th>Featured</th></tr></thead>
                            <tbody>
                                @foreach (var article in Model)
                                {
                                    <tr>
                                        <td class="small">@article.Title</td>
                                        <td class="small">@article.Category.ToDisplayName()</td>
                                        <td class="small">@article.Author</td>
                                        <td class="small">@article.PublishedDate.ToString("dd MMM yyyy")</td>
                                        <td class="small">@(article.Featured ? "Yes" : "No")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


