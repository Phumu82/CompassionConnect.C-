@model Volunteer
@{
    ViewData["Title"] = "Application Received";
}

<section class="py-5">
    <div class="container text-center" style="max-width: 620px;">
        <div class="gg-avatar mx-auto mb-4" style="width: 72px; height: 72px; font-size: 2rem; background-color: rgba(46,139,87,0.12); color: var(--gg-success);">
            <i class="bi bi-check-lg"></i>
        </div>
        <h1>Application received!</h1>
        <p class="text-muted lead">Thank you, @Model.FullName. We'll review your application and be in touch soon.</p>

        <div class="card p-4 text-start mt-4">
            <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                <span class="text-muted">Reference number</span>
                <span class="fw-bold">@Model.ReferenceNumber</span>
            </div>
            <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                <span class="text-muted">Province</span>
                <span class="fw-bold">@Model.Province</span>
            </div>
            <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                <span class="text-muted">Availability</span>
                <span class="fw-bold">@Model.Availability</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">Status</span>
                <span class="status-pill pending">@Model.Status</span>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
            <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Back to home</a>
            <a class="btn btn-primary" asp-controller="Donation" asp-action="Index">Support with a donation</a>
        </div>
    </div>
</section>


