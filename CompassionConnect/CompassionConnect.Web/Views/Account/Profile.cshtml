@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<section class="py-5">
    <div class="container" style="max-width: 720px;">
        <h2 class="mb-1">My Profile</h2>
        <p class="text-muted mb-4">@Model.Role account &middot; Member since @Model.MemberSince.ToString("MMMM yyyy")</p>

        <div class="card p-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <form asp-controller="Account" asp-action="Profile" method="post">
                <input type="hidden" asp-for="Role" />
                <input type="hidden" asp-for="MemberSince" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PostalCode" class="form-label"></label>
                        <input asp-for="PostalCode" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Province" class="form-label"></label>
                        <input asp-for="Province" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4">Save changes</button>
            </form>
        </div>
    </div>
</section>
