@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="py-5">
    <div class="container">
        <div class="card gg-auth-card p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="gg-logo-mark d-inline-flex mb-3">GG</span>
                <h3>Reset your password</h3>
                <p class="text-muted small">Enter your email and we'll send you reset instructions.</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Send reset instructions</button>
            </form>

            <p class="text-center small text-muted mt-4 mb-0">
                <a asp-controller="Account" asp-action="LoginDonor">Back to login</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
