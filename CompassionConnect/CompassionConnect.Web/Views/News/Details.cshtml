@model NewsArticle
@{
    ViewData["Title"] = Model.Title;
}

<section class="py-5">
    <div class="container" style="max-width: 800px;">
        <a asp-controller="News" asp-action="Index" class="small text-muted"><i class="bi bi-arrow-left me-1"></i>Back to news</a>

        <div class="d-flex gap-2 align-items-center mt-3 mb-2">
            <span class="badge badge-soft-primary">@Model.Category.ToDisplayName()</span>
            <span class="small text-muted">@Model.PublishedDate.ToString("dd MMMM yyyy")</span>
            <span class="small text-muted">&middot; @Model.ReadMinutes min read</span>
        </div>
        <h1>@Model.Title</h1>
        <p class="text-muted">By @Model.Author</p>

        <img src="@Model.ImageUrl" class="img-fluid rounded-4 w-100 object-fit-cover my-4" style="height: 360px;" alt="@Model.ImageAlt" onerror="this.src='/images/news/default-news.jpg'" />

        <div style="white-space: pre-line; font-size: 1.05rem; line-height: 1.75;">@Model.Body</div>

        <div class="card p-4 mt-5" style="background-color: var(--gg-primary-soft); border: none;">
            <h5>Help us continue this work</h5>
            <p class="text-muted small mb-3">Your donation funds the field teams behind stories like this one.</p>
            <a class="btn btn-emergency" asp-controller="Donation" asp-action="Index">Donate now</a>
        </div>
    </div>
</section>
