@{
    var current = ViewContext.RouteData.Values["action"]?.ToString();
}
<div class="gg-sidebar-nav rounded-4 p-3 mb-4 mb-lg-0">
    <div class="text-white fw-bold px-2 mb-3"><i class="bi bi-person-heart me-2"></i>My Account</div>
    <nav class="nav flex-column gap-1">
        <a class="nav-link @(current == "Dashboard" ? "active" : "")" asp-controller="Donor" asp-action="Dashboard"><i class="bi bi-grid-1x2 me-2"></i>Overview</a>
        <a class="nav-link @(current == "History" ? "active" : "")" asp-controller="Donor" asp-action="History"><i class="bi bi-clock-history me-2"></i>Donation History</a>
        <a class="nav-link @(current == "TaxCertificates" ? "active" : "")" asp-controller="Donor" asp-action="TaxCertificates"><i class="bi bi-receipt me-2"></i>Tax Certificates</a>
        <a class="nav-link" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-gear me-2"></i>Profile</a>
        <a class="nav-link" asp-controller="Account" asp-action="Settings"><i class="bi bi-gear me-2"></i>Settings</a>
    </nav>
</div>
