@model DonateViewModel
@{
    ViewData["Title"] = "Donate";
}

<section class="gg-hero py-5">
    <div class="container py-3 text-center">
        <span class="gg-eyebrow text-white-50">Every rand counts</span>
        <h1 class="mt-2">Make a donation</h1>
        <p class="lead mx-auto" style="max-width: 36rem; color: rgba(255,255,255,0.85);">
            Donate with or without an account. Every donation receives an instant Section 18A tax certificate.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7">
                <div class="card p-4 p-md-5">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form asp-controller="Donation" asp-action="Index" method="post">
                        <h5 class="mb-3">1. Choose an amount</h5>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button type="button" class="btn btn-outline-primary" data-amount-preset="250">R250</button>
                            <button type="button" class="btn btn-outline-primary" data-amount-preset="500">R500</button>
                            <button type="button" class="btn btn-outline-primary" data-amount-preset="1000">R1,000</button>
                            <button type="button" class="btn btn-outline-primary" data-amount-preset="2500">R2,500</button>
                            <button type="button" class="btn btn-outline-primary" data-amount-preset="5000">R5,000</button>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label">Amount (ZAR)</label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input asp-for="Amount" class="form-control form-control-lg" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ProjectId" class="form-label">Direct my donation to (optional)</label>
                            <select asp-for="ProjectId" class="form-select">
                                <option value="">General Emergency Fund (wherever needed most)</option>
                                @foreach (var project in Model.AvailableProjects ?? Array.Empty<ReliefProject>())
                                {
                                    <option value="@project.ProjectId">@project.Title &mdash; @project.Province</option>
                                }
                            </select>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsRecurring" class="form-check-input" role="switch" />
                            <label asp-for="IsRecurring" class="form-check-label"></label>
                        </div>

                        <h5 class="mb-3">2. Your details</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label"></label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IdNumber" class="form-label"></label>
                                <input asp-for="IdNumber" class="form-control" />
                                <div class="form-text">Required for a valid Section 18A tax certificate.</div>
                            </div>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="IsAnonymous" class="form-check-input" />
                            <label asp-for="IsAnonymous" class="form-check-label"></label>
                        </div>

                        <h5 class="mb-3">3. Payment method</h5>
                        <div class="row g-2 mb-4">
                            @foreach (var method in Enum.GetValues<PaymentMethod>())
                            {
                                <div class="col-6 col-md-3">
                                    <input type="radio" class="btn-check" asp-for="PaymentMethod" id="pm-@method" value="@method" autocomplete="off" checked="@(Model.PaymentMethod == method)" />
                                    <label class="btn btn-outline-primary w-100" for="pm-@method">@method</label>
                                </div>
                            }
                        </div>

                        <input type="hidden" asp-for="Currency" />
                        <button type="submit" class="btn btn-emergency btn-lg w-100">
                            <i class="bi bi-heart-fill me-2"></i>Complete Donation
                        </button>
                        <p class="text-center small text-muted mt-3 mb-0">
                            <i class="bi bi-lock-fill me-1"></i>Secure payment. You do not need an account to donate.
                        </p>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card p-4 mb-4" style="background-color: var(--gg-primary-soft); border: none;">
                    <h5><i class="bi bi-receipt me-2"></i>Instant Tax Certificate</h5>
                    <p class="text-muted small mb-0">
                        As a registered Public Benefit Organisation (PBO 930033254), every donation qualifies
                        for a Section 18A tax certificate, generated instantly and available for download from
                        your donor dashboard.
                    </p>
                </div>
                <div class="card p-4">
                    <h5><i class="bi bi-graph-up-arrow me-2"></i>Your Impact</h5>
                    <ul class="list-unstyled small text-muted mt-3 mb-0">
                        <li class="mb-2"><i class="bi bi-check-circle text-success-strong me-2"></i>R250 provides emergency food for a family of five for a week</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success-strong me-2"></i>R500 supplies clean water containers for ten households</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success-strong me-2"></i>R1,000 covers a mobile clinic consultation day for twenty patients</li>
                        <li><i class="bi bi-check-circle text-success-strong me-2"></i>R5,000 rebuilds a flood-damaged classroom wall</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
