@model IReadOnlyList<ReliefProject>
@{
    ViewData["Title"] = "Relief Projects";
}

<section class="gg-hero py-5">
    <div class="container py-3 text-center">
        <span class="gg-eyebrow text-white-50">Our work</span>
        <h1 class="mt-2">Active Relief Projects</h1>
        <p class="lead mx-auto" style="max-width: 36rem; color: rgba(255,255,255,0.85);">
            From flood response to mobile medical clinics, explore where your support goes and choose a
            project close to your heart.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <form class="row g-2 mb-4" method="get">
            <div class="col-md-4">
                <select name="category" class="form-select" onchange="this.form.submit()">
                    <option value="">All categories</option>
                    @foreach (var category in Enum.GetValues<ProjectCategory>())
                    {
                        <option value="@category" selected="@(Context.Request.Query["category"] == category.ToString())">@category</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select name="province" class="form-select" onchange="this.form.submit()">
                    <option value="">All provinces</option>
                    @foreach (var province in Model.Select(p => p.Province).Distinct().OrderBy(p => p))
                    {
                        <option value="@province" selected="@(Context.Request.Query["province"] == province)">@province</option>
                    }
                </select>
            </div>
        </form>

        <div class="row g-4">
            @foreach (var project in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-hover h-100">
                        <div class="position-relative">
                            <img src="@project.ImageUrl" class="card-img-top object-fit-cover" style="height: 200px;" alt="@project.Title" onerror="this.src='/images/campaigns/default-campaign.jpg'" />
                            @if (project.IsEmergency)
                            {
                                <span class="badge badge-emergency position-absolute top-0 start-0 m-3">Emergency</span>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex gap-2 mb-2">
                                <span class="badge badge-soft-primary">@project.Province</span>
                                <span class="badge bg-light text-dark border">@project.Category</span>
                            </div>
                            <h5 class="card-title">@project.Title</h5>
                            <p class="card-text text-muted small flex-grow-1">@project.Summary</p>
                            <div class="gg-progress mb-2"><div style="width: @(project.PercentFunded.ToString("0.##"))%"></div></div>
                            <div class="d-flex justify-content-between small mb-3">
                                <span class="fw-semibold">R@(project.RaisedAmount.ToString("N0")) raised</span>
                                <span class="text-muted">@project.PercentFunded.ToString("0")% funded</span>
                            </div>
                            <a class="btn btn-outline-primary w-100" asp-controller="Project" asp-action="Details" asp-route-slug="@project.Slug">View project</a>
                        </div>
                    </div>
                </div>
            }
            @if (!Model.Any())
            {
                <div class="col-12">
                    <div class="alert alert-info">No projects match your filters.</div>
                </div>
            }
        </div>
    </div>
</section>
