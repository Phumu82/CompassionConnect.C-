@model ProjectEditViewModel
@{
    ViewData["Title"] = "Edit Relief Project";
}
<section class="py-5">
    <div class="container" style="max-width: 900px;">
        <h2 class="mb-4">Edit Relief Project</h2>
        <div class="card p-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <form asp-controller="Project" asp-action="Edit" asp-route-id="@Model.ProjectId" method="post">
                <partial name="_Form" model="Model" />
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a asp-controller="Employee" asp-action="Projects" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
