@model ReliefProject
@{
    ViewData["Title"] = Model.Title;
}

<section class="py-5">
    <div class="container">
        <a asp-controller="Project" asp-action="Index" class="small text-muted"><i class="bi bi-arrow-left me-1"></i>Back to all projects</a>

        <div class="row g-5 mt-1">
            <div class="col-lg-7">
                <img src="@Model.ImageUrl" class="img-fluid rounded-4 object-fit-cover mb-4 w-100" style="height: 340px;" alt="@Model.Title" onerror="this.src='/images/campaigns/default-campaign.jpg'" />
                <div class="d-flex gap-2 mb-3">
                    <span class="badge badge-soft-primary">@Model.Province</span>
                    <span class="badge bg-light text-dark border">@Model.Category</span>
                    @if (Model.IsEmergency)
                    {
                        <span class="badge badge-emergency">Emergency</span>
                    }
                    <span class="status-pill @Model.Status.ToString().ToLower()">@Model.Status</span>
                </div>
                <h1>@Model.Title</h1>
                <p class="lead text-muted">@Model.Summary</p>
                <p style="white-space: pre-line;">@Model.Description</p>

                @if (Model.ProjectLead is not null)
                {
                    <div class="d-flex align-items-center gap-3 mt-4 p-3 rounded-4" style="background-color: var(--gg-primary-soft);">
                        <div class="gg-avatar">@Model.ProjectLead.FullName.Substring(0,1)</div>
                        <div>
                            <div class="fw-semibold">@Model.ProjectLead.FullName</div>
                            <div class="text-muted small">@Model.ProjectLead.JobTitle &middot; Project Lead</div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-5">
                <div class="card p-4 position-sticky" style="top: 6rem;">
                    <div class="gg-progress mb-2"><div style="width: @(Model.PercentFunded.ToString("0.##"))%"></div></div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="fs-4 fw-bold">R@(Model.RaisedAmount.ToString("N0"))</span>
                        <span class="text-muted align-self-end">of R@(Model.GoalAmount.ToString("N0"))</span>
                    </div>
                    <p class="text-muted small mb-4">@Model.PercentFunded.ToString("0")% funded &middot; @Model.PeopleAssisted.ToString("N0") people assisted so far</p>

                    <a class="btn btn-emergency btn-lg w-100 mb-2" asp-controller="Donation" asp-action="Index" asp-route-projectId="@Model.ProjectId">
                        <i class="bi bi-heart-fill me-2"></i>Donate to this project
                    </a>
                    <a class="btn btn-outline-primary w-100" asp-controller="Volunteer" asp-action="Index" asp-route-projectId="@Model.ProjectId">
                        <i class="bi bi-people-fill me-2"></i>Volunteer for this project
                    </a>

                    <hr class="my-4" />
                    <div class="small text-muted">
                        <div class="d-flex justify-content-between mb-2"><span>Started</span><span>@Model.StartDate.ToString("dd MMM yyyy")</span></div>
                        @if (Model.EndDate.HasValue)
                        {
                            <div class="d-flex justify-content-between"><span>Target completion</span><span>@Model.EndDate.Value.ToString("dd MMM yyyy")</span></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
