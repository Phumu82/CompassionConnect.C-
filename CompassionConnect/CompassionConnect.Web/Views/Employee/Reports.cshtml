@model IReadOnlyList<ReliefProject>
@{
    ViewData["Title"] = "Reports";
}
<section class="py-5">
    <div class="container-fluid px-4">
        <div class="row">
            <div class="col-lg-3"><partial name="_EmployeeSidebar" /></div>
            <div class="col-lg-9">
                <h2 class="mb-4">Impact Reports</h2>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="gg-kpi-card">
                            <div class="text-muted small">Total Raised</div>
                            <div class="fs-4 fw-bold">R@(((decimal)ViewBag.TotalRaised).ToString("N0"))</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="gg-kpi-card">
                            <div class="text-muted small">Combined Funding Goal</div>
                            <div class="fs-4 fw-bold">R@(((decimal)ViewBag.TotalGoal).ToString("N0"))</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="gg-kpi-card">
                            <div class="text-muted small">People Assisted</div>
                            <div class="fs-4 fw-bold">@(((int)ViewBag.PeopleAssisted).ToString("N0"))</div>
                        </div>
                    </div>
                </div>
                <div class="card p-4">
                    <h5 class="mb-3">Funding by Project</h5>
                    <div class="table-responsive">
                        <table class="table table-gg align-middle">
                            <thead><tr><th>Project</th><th>Category</th><th>Raised</th><th>Goal</th><th>% Funded</th></tr></thead>
                            <tbody>
                                @foreach (var project in Model)
                                {
                                    <tr>
                                        <td class="small">@project.Title</td>
                                        <td class="small">@project.Category</td>
                                        <td class="small">R@(project.RaisedAmount.ToString("N0"))</td>
                                        <td class="small">R@(project.GoalAmount.ToString("N0"))</td>
                                        <td>
                                            <div class="gg-progress" style="width: 120px;"><div style="width: @(project.PercentFunded.ToString("0.##"))%"></div></div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
