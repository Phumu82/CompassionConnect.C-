@model VolunteerRegisterViewModel
@{
    ViewData["Title"] = "Volunteer";
    var skillOptions = new[] { "Medical", "Driving", "Logistics", "Counselling", "Construction", "Administration", "Translation", "First Aid" };
    var provinces = new[] { "Eastern Cape", "Free State", "Gauteng", "KwaZulu-Natal", "Limpopo", "Mpumalanga", "Northern Cape", "North West", "Western Cape" };
}

<section class="gg-hero py-5">
    <div class="container py-3 text-center">
        <span class="gg-eyebrow text-white-50">Give your time</span>
        <h1 class="mt-2">Become a volunteer</h1>
        <p class="lead mx-auto" style="max-width: 36rem; color: rgba(255,255,255,0.85);">
            Join thousands of South Africans who give their skills and time to disaster response, medical
            outreach and community rebuilding.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7">
                <div class="card p-4 p-md-5">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form asp-controller="Volunteer" asp-action="Index" method="post">
                        <h5 class="mb-3">Your details</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label"></label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IdNumber" class="form-label"></label>
                                <input asp-for="IdNumber" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Province" class="form-label"></label>
                                <select asp-for="Province" class="form-select">
                                    <option value="">Select your province</option>
                                    @foreach (var province in provinces)
                                    {
                                        <option value="@province">@province</option>
                                    }
                                </select>
                                <span asp-validation-for="Province" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Availability" class="form-label"></label>
                                <select asp-for="Availability" class="form-select">
                                    @foreach (var a in Enum.GetValues<Availability>())
                                    {
                                        <option value="@a">@a</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <h5 class="mb-3">Your skills</h5>
                        <div class="row g-2 mb-4">
                            @foreach (var skill in skillOptions)
                            {
                                <div class="col-6 col-md-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Skills" value="@skill" id="skill-@skill" />
                                        <label class="form-check-label small" for="skill-@skill">@skill</label>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mb-4">
                            <label asp-for="ProjectId" class="form-label">Preferred project (optional)</label>
                            <select asp-for="ProjectId" class="form-select">
                                <option value="">No preference &mdash; deploy me where needed</option>
                                @foreach (var project in Model.AvailableProjects ?? Array.Empty<ReliefProject>())
                                {
                                    <option value="@project.ProjectId">@project.Title &mdash; @project.Province</option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Motivation" class="form-label"></label>
                            <textarea asp-for="Motivation" class="form-control" rows="4" placeholder="Tell us why you'd like to volunteer..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-people-fill me-2"></i>Submit application
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card p-4 mb-4" style="background-color: var(--gg-primary-soft); border: none;">
                    <h5><i class="bi bi-clipboard-check me-2"></i>What happens next?</h5>
                    <ol class="small text-muted mt-3 mb-0 ps-3">
                        <li class="mb-2">We review your application within 3&ndash;5 working days.</li>
                        <li class="mb-2">Approved volunteers receive an orientation call.</li>
                        <li>You're matched to a project based on your skills and availability.</li>
                    </ol>
                </div>
                <div class="card p-4">
                    <h5><i class="bi bi-heart me-2"></i>Why volunteer with us?</h5>
                    <ul class="list-unstyled small text-muted mt-3 mb-0">
                        <li class="mb-2"><i class="bi bi-check-circle text-success-strong me-2"></i>Meaningful, hands-on impact in your community</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success-strong me-2"></i>Training and safety briefings provided</li>
                        <li><i class="bi bi-check-circle text-success-strong me-2"></i>Flexible commitment &mdash; from a single weekend to ongoing support</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
